HOST=0.0.0.0
PORT=3101
APP_ENV=production
API_HOST_PORT=3101
WEB_HOST_PORT=3100
FRONTEND_URLS=http://localhost:3100,http://127.0.0.1:3100,http://<LAN-IP>:3100
NEXT_PUBLIC_API_URL=http://<LAN-IP>:3101
NEXT_PUBLIC_PROJECT_STORAGE=server
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false
# Web 容器内置导演台静态路径；本地独立调试可改为 http://127.0.0.1:5173/。
NEXT_PUBLIC_DIRECTOR_DESK_URL=/director-desk/index.html

STORAGE_DRIVER=postgres
REQUIRE_PERSISTENT_STORAGE=true
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-postgres-password
DB_NAME=ai_manju
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800

APP_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ALLOW_PUBLIC_SIGNUP=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=Super Admin
ASSET_STORAGE_DIR=/app/data/assets
MAX_ASSET_UPLOAD_BYTES=104857600
ASSET_ARCHIVE_TIMEZONE=Asia/Shanghai
# Public HTTPS origin used when registering locally uploaded files with the remote asset library.
PUBLIC_ASSET_BASE_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=ai_manju
POSTGRES_HOST_PORT=55432

REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_QUEUE_NAME=celery
JOB_MAX_ATTEMPTS=3
JOB_DEFAULT_TIMEOUT=900
WORKER_HEALTH_HOST_PORT=8101
WORKER_CONCURRENCY=8
# Optional per-worker Celery rate for remote image generation/edit tasks, for example 2/s.
WORKER_PROVIDER_RATE_LIMIT=

# Capacity override defaults used by deploy/docker-compose.capacity.yml.
POSTGRES_MAX_CONNECTIONS=100
REDIS_MAXMEMORY=1gb
REDIS_MAXCLIENTS=1000

# Development-only bootstrap defaults when APP_ENV is not production:
# APP_SECRET=dev-local-session-secret-change-before-production
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin12345
# ADMIN_DISPLAY_NAME=Local Admin
# ALLOW_PUBLIC_SIGNUP=false
#
# Production never defaults secrets or admin credentials. Set strong
# APP_SECRET, ADMIN_PASSWORD, database credentials, and FRONTEND_URLS before
# running APP_ENV=production.
