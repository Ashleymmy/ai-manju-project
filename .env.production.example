# Copy this file to .env on the production server and replace every CHANGE_ME value.

APP_ENV=production

# Bind app containers to localhost; expose public traffic through Nginx/HTTPS.
API_HOST_PORT=127.0.0.1:3101
WEB_HOST_PORT=127.0.0.1:3100
POSTGRES_HOST_PORT=127.0.0.1:55432
REDIS_HOST_PORT=127.0.0.1:6379
WORKER_HEALTH_HOST_PORT=127.0.0.1:8101

# Browser-facing URLs. VITE_API_URL is baked into the Studio image during build.
FRONTEND_URLS=https://aicavans.cc,https://www.aicavans.cc
VITE_API_URL=https://aicavans.cc
NEXT_PUBLIC_PROJECT_STORAGE=server
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false
NEXT_PUBLIC_DIRECTOR_DESK_URL=/director-desk/index.html

# Persistent storage.
STORAGE_DRIVER=postgres
REQUIRE_PERSISTENT_STORAGE=true
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DB_NAME=ai_manju
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=ai_manju

# Auth and account bootstrap.
APP_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Keep COOKIE_SECURE=true only when the browser reaches the site through HTTPS.
# For HTTP-only preview/LAN deployments set COOKIE_SECURE=false, otherwise the browser will reject the session cookie.
COOKIE_SECURE=true
ALLOW_PUBLIC_SIGNUP=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_DISPLAY_NAME=Super Admin

# Uploaded/generated assets. Keep this <= deploy/aicavans.cc.conf client_max_body_size.
ASSET_STORAGE_DIR=/app/data/assets
MAX_ASSET_UPLOAD_BYTES=104857600
ASSET_ARCHIVE_TIMEZONE=Asia/Shanghai
# Public HTTPS origin of this API, required for local-file registration in the remote asset library.
PUBLIC_ASSET_BASE_URL=https://api.example.com

# Long-running job queue.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_QUEUE_NAME=celery
JOB_MAX_ATTEMPTS=3
JOB_DEFAULT_TIMEOUT=900
WORKER_CONCURRENCY=8
# Leave empty until the provider account quota is known. Example: 2/s per worker replica.
WORKER_PROVIDER_RATE_LIMIT=

# deploy/docker-compose.capacity.yml defaults; tune to the host before rollout.
POSTGRES_MAX_CONNECTIONS=100
REDIS_MAXMEMORY=1gb
REDIS_MAXCLIENTS=1000
