# Copy this file to .env on the production server and replace every CHANGE_ME value.

APP_ENV=production

# Bind app containers to localhost; expose public traffic through Nginx/HTTPS.
API_HOST_PORT=127.0.0.1:3101
WEB_HOST_PORT=127.0.0.1:3100
POSTGRES_HOST_PORT=127.0.0.1:55432

# Browser-facing URLs. NEXT_PUBLIC_API_URL is baked into the web image during build.
FRONTEND_URLS=https://aicavans.cc,https://www.aicavans.cc
NEXT_PUBLIC_API_URL=https://aicavans.cc
NEXT_PUBLIC_PROJECT_STORAGE=server
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false

# Persistent storage.
STORAGE_DRIVER=postgres
REQUIRE_PERSISTENT_STORAGE=true
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DB_NAME=ai_manju
DB_SSLMODE=disable

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=ai_manju

# Auth and account bootstrap.
APP_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=true
ALLOW_PUBLIC_SIGNUP=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_DISPLAY_NAME=Super Admin

# Uploaded/generated assets. Keep this <= deploy/aicavans.cc.conf client_max_body_size.
ASSET_STORAGE_DIR=/app/data/assets
MAX_ASSET_UPLOAD_BYTES=104857600
