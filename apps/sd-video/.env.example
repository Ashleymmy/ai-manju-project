SERVICE_JWT_AUDIENCE=sd-video
SERVICE_JWT_ALGORITHMS=EdDSA,RS256
STORAGE_BACKEND=local

# New SD-video database/storage only. Never copy values from D:\ITEM\SD-video.
SDVIDEO_POSTGRES_HOST_PORT=55433
SDVIDEO_POSTGRES_USER=sdvideo
SDVIDEO_POSTGRES_PASSWORD=replace-with-a-new-password
SDVIDEO_POSTGRES_DB=sdvideo_cloud
