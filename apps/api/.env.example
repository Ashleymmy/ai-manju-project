PORT=3101
APP_ENV=development
FRONTEND_URL=http://localhost:3100
FRONTEND_URLS=http://localhost:3100,http://127.0.0.1:3100

# Business/runtime storage must be postgres. Use memory only for throwaway local development.
STORAGE_DRIVER=postgres
REQUIRE_PERSISTENT_STORAGE=true
COOKIE_SECURE=false
ALLOW_PUBLIC_SIGNUP=false
ASSET_STORAGE_DIR=./data/assets
MAX_ASSET_UPLOAD_BYTES=104857600
ASSET_ARCHIVE_TIMEZONE=Asia/Shanghai
# Required for registering LocalFS uploads with the remote asset library.
PUBLIC_ASSET_BASE_URL=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_QUEUE_NAME=celery
JOB_MAX_ATTEMPTS=3
JOB_DEFAULT_TIMEOUT=900
WORKER_HEALTH_HOST_PORT=8101
WORKER_CONCURRENCY=8
WORKER_PROVIDER_RATE_LIMIT=

# WebDAV proxy is disabled until at least one exact hostname, IP, or CIDR is allowed.
# Private NAS targets require both the hostname (when used) and an explicit private IP/CIDR entry.
WEBDAV_ALLOWED_HOSTS=
WEBDAV_PROXY_TIMEOUT_SECONDS=120
WEBDAV_MAX_REQUEST_BYTES=104857600

# PostgreSQL is required when STORAGE_DRIVER=postgres. Set DATABASE_URL or DB_*.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_manju?sslmode=disable
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=ai_manju
# DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800

# Optional local-only volatile mode:
# APP_ENV=development
# STORAGE_DRIVER=memory
# REQUIRE_PERSISTENT_STORAGE=false

# Development-only bootstrap defaults when APP_ENV is not production:
# APP_SECRET=dev-local-session-secret-change-before-production
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin12345
# ADMIN_DISPLAY_NAME=Local Admin
# ALLOW_PUBLIC_SIGNUP=false
#
# Production must set explicit strong values:
# APP_ENV=production
# STORAGE_DRIVER=postgres
# REQUIRE_PERSISTENT_STORAGE=true
# APP_SECRET=replace-with-at-least-32-random-characters
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-admin-password
# COOKIE_SECURE=true
# ALLOW_PUBLIC_SIGNUP=false
