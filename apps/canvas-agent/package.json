{
  "name": "@basketikun/canvas-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "canvas-agent": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "pnpm --filter @ai-manju/canvas-agent-protocol build && tsc -p tsconfig.json && node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "^0.139.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ai-manju/canvas-agent-protocol": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
