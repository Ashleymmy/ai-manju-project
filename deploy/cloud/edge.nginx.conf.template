log_format safe_access escape=json '{"time":"$time_iso8601","method":"$request_method","path":"$uri","status":$status,"duration":$request_time}';
# 仅容器内回环探活，不绕过 HTTPS 对外提供业务内容。
server {
    listen 127.0.0.1:8080;
    access_log off;
    location = /health/live { return 200 "ok\n"; }
    location / { return 404; }
}
server {
    listen 443 ssl;
    server_name ${STUDIO_DOMAIN};
    ssl_certificate /run/tls/public/fullchain.pem;
    ssl_certificate_key /run/tls/public/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 512m;
    # 不记录 query：其中可能包含短期媒体签名。
    access_log /dev/stdout safe_access;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    location / {
        proxy_pass http://web:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
    }
}
