APP_ENV=production
SD_VIDEO_EXECUTION_MODE=provider
SD_VIDEO_MODE=disabled
LOCAL_DEMO_MODE=false
ALLOW_CORS=false
SERVICE_JWT_PUBLIC_KEY=file:/run/secrets/sdvideo/studio-verifier.pem
SERVICE_JWT_ISSUER=ai-manju-studio
SERVICE_JWT_AUDIENCE=sd-video
SDVIDEO_DATABASE_URL_FILE=/run/secrets/sdvideo/database-url
SDVIDEO_REDIS_URL=redis://sd-video-redis:6379/0
SDVIDEO_DATA_DIR=/app/data
STORAGE_BACKEND=supabase
SDVIDEO_SUPABASE_URL=https://storage.internal.example.invalid
SDVIDEO_SUPABASE_PUBLIC_URL=https://storage-media.example.invalid
SDVIDEO_SUPABASE_STORAGE_TOKEN_FILE=/run/secrets/sdvideo/storage-token
SDVIDEO_SUPABASE_API_KEY_FILE=
SDVIDEO_SUPABASE_CA_FILE=
SDVIDEO_SUPABASE_RESULT_BUCKET=studio-sdvideo-test-results
SDVIDEO_SUPABASE_INPUT_BUCKET=studio-sdvideo-test-inputs
SDVIDEO_SUPABASE_THUMBNAIL_BUCKET=studio-sdvideo-test-thumbnails
SDVIDEO_SUPABASE_VOLCANO_BUCKET=studio-sdvideo-test-volcano
# 凭证未配置的模型禁用；不要填写旧 SD-video 的密钥。
SEEDANCE20_PROVIDER=legacy_proxy
SEEDANCE20_URL=
SEEDANCE20_KEY=
TOKENSPACE_API_KEY=
VIDU_API_KEY=
YIKE_API_KEY=
AMK_API_KEY=
SDVIDEO_WORKER_INTERVAL_SECONDS=5
SDVIDEO_WORKER_LEASE_SECONDS=120
TASK_POLL_INTERVAL_SECONDS=10
