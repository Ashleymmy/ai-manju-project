# 以下仅为参数登记模板；运行时密钥不进入本文件，不使用 latest 镜像。
STUDIO_API_IMAGE=registry.example.invalid/studio-api@sha256:REPLACE
STUDIO_WEB_IMAGE=registry.example.invalid/studio-web@sha256:REPLACE
STUDIO_WORKER_IMAGE=registry.example.invalid/studio-worker@sha256:REPLACE
SDVIDEO_IMAGE=registry.example.invalid/sd-video@sha256:REPLACE
POSTGRES_IMAGE=postgres@sha256:REPLACE
REDIS_IMAGE=redis@sha256:REPLACE
NGINX_IMAGE=nginx@sha256:REPLACE
STUDIO_DOMAIN=studio.example.invalid
STUDIO_RUNTIME_ENV=/srv/studio-config/studio.runtime.env
SDVIDEO_RUNTIME_ENV=/srv/studio-config/sdvideo.runtime.env
STUDIO_SECRET_DIR=/srv/studio-secrets/studio
SDVIDEO_SECRET_DIR=/srv/studio-secrets/sdvideo
# 仅 compose.storage-tokens.yml 使用；独立读组不能互相复用，目录不能放其他 Secret。
STUDIO_STORAGE_TOKEN_DIR=/srv/studio-storage-tokens/studio
SDVIDEO_STORAGE_TOKEN_DIR=/srv/studio-storage-tokens/sdvideo
STUDIO_STORAGE_TOKEN_GID=21001
SDVIDEO_STORAGE_TOKEN_GID=21002
STUDIO_DB_PASSWORD_FILE=/srv/studio-secrets/studio/db-password
SDVIDEO_DB_PASSWORD_FILE=/srv/studio-secrets/sdvideo/db-password
SDVIDEO_CA_FILE=/srv/studio-secrets/sdvideo-tls/ca.crt
SDVIDEO_TLS_DIR=/srv/studio-secrets/sdvideo-tls
STUDIO_TLS_DIR=/srv/studio-secrets/public-tls
