APP_ENV=production
HOST=0.0.0.0
PORT=3101
STORAGE_DRIVER=postgres
REQUIRE_PERSISTENT_STORAGE=true
DB_HOST=postgres
DB_PORT=5432
DB_USER=studio
DB_NAME=studio_cloud
DB_PASSWORD_FILE=/run/secrets/studio/db-password
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
FRONTEND_URLS=https://studio.example.invalid
APP_SECRET_FILE=/run/secrets/studio/app-secret
ADMIN_USERNAME=internal-admin
ADMIN_PASSWORD_FILE=/run/secrets/studio/admin-password
ADMIN_DISPLAY_NAME=内测管理员
ALLOW_PUBLIC_SIGNUP=false
COOKIE_SECURE=true
ASSET_STORAGE_BACKEND=supabase
ASSET_STORAGE_DIR=/app/data/assets
WORKER_TMP_DIR=/tmp/worker
# 私网读写入口和浏览器/Provider 可达的签名媒体入口分开；不填写旧全权 Key。
STUDIO_SUPABASE_URL=https://storage.internal.example.invalid
STUDIO_SUPABASE_PUBLIC_URL=https://storage-media.example.invalid
STUDIO_SUPABASE_BUCKET=studio-test-assets
STUDIO_SUPABASE_STORAGE_TOKEN_FILE=/run/secrets/studio/storage-token
# 仅 Kong 要求 apikey 时挂载公开 anon JWT；不是 service_role。
STUDIO_SUPABASE_API_KEY_FILE=
STUDIO_SUPABASE_CA_FILE=
# NAS 是持久副本；OSS/ESA/CDN 分发链路另行确认，不默认启用。
ASSET_CDN_BASE_URL=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_QUEUE_NAME=celery
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=1
SD_VIDEO_BASE_URL=https://sd-video-api:8201
SD_VIDEO_MODE=disabled
SD_VIDEO_ALLOWED_WORKSPACES=
SD_VIDEO_ALLOWED_MODELS=
SD_VIDEO_JWT_PRIVATE_KEY_FILE=/run/secrets/studio/sdvideo-signing-key
SD_VIDEO_JWT_KID=studio-sdvideo-internal-1
SD_VIDEO_CA_FILE=/run/tls/sdvideo-ca.crt
SD_VIDEO_BRIDGE_ENABLED=true
SD_VIDEO_REQUEST_TIMEOUT_MILLISECONDS=120000
